generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("AGENT")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("users")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("POISSON")
  purchasePrice Float
  sellingPrice  Float
  unit          String   @default("kg")
  stock         Float?
  active        Boolean  @default(true)
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems SaleItem[]

  @@map("products")
}

model Service {
  id         String   @id @default(cuid())
  name       String
  price      Float
  promoPrice Float?
  isPromo    Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  saleServices SaleService[]

  @@map("services")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales         Sale[]
  subscriptions Subscription[]

  @@map("clients")
}

model Sale {
  id             String        @id @default(cuid())
  agentId        String
  agent          User          @relation(fields: [agentId], references: [id])
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  referralCodeId String?
  referralCode   ReferralCode? @relation(fields: [referralCodeId], references: [id])
  commission     Float?
  date           DateTime      @default(now())
  paymentStatus  String        @default("PENDING")
  paymentMethod  String        @default("DIRECT")
  notes          String?
  totalAmount    Float
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    SaleItem[]
  services SaleService[]

  @@map("sales")
}

model ReferralCode {
  id                    String         @id @default(cuid())
  code                  String         @unique
  name                  String
  username              String         @unique
  commissionWithService Float          @default(10)
  commissionNoService   Float          @default(5)
  status                Boolean        @default(true)
  notes                 String?
  whatsappLink          String
  level                 Int            @default(0)
  parentCodeId          String?
  parentCode            ReferralCode?  @relation("SubReferrals", fields: [parentCodeId], references: [id])
  subCodes              ReferralCode[] @relation("SubReferrals")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  orders Sale[]

  @@map("referral_codes")
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  pricePerKg Float
  subtotal   Float
  createdAt  DateTime @default(now())

  @@map("sale_items")
}

model SaleService {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  price     Float
  createdAt DateTime @default(now())

  @@map("sale_services")
}

model Subscription {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  startDate        DateTime
  endDate          DateTime?
  status           String    @default("ACTIVE")
  weeklyDeliveries Int       @default(0)
  referredBy       String?
  bonusApplied     Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("subscriptions")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Campaign {
  id               String        @id @default(cuid())
  name             String
  message          String
  status           String        @default("DRAFT")
  totalSent        Int           @default(0)
  totalFailed      Int           @default(0)
  totalTargets     Int           @default(0)
  baseDelaySeconds Int           @default(12)
  source           String        @default("DB_CLIENTS")
  phones           String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  logs CampaignLog[]

  @@map("campaigns")
}

model CampaignLog {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone      String
  status     String
  error      String?
  sentAt     DateTime @default(now())

  @@map("campaign_logs")
}
